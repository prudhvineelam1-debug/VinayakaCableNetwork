<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── IMMERSIVE PREMIUM HEADER ── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_dashboard_header_main" />
                <View
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-60dp"
                    android:layout_marginEnd="-60dp"
                    android:alpha="0.15"
                    android:background="@drawable/bg_white_circle_blur" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:id="@+id/header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vinayaka Cable"
                                android:textColor="#FFFFFF"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvUsername"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Welcome Back!"
                                android:textColor="#A5B4FC"
                                android:textSize="14sp" />
                        </LinearLayout>
                        <FrameLayout
                            android:id="@+id/ivProfileAvatar"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_avatar_circle_white">
                            <TextView
                                android:id="@+id/tvProfileInitial"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="A"
                                android:textColor="#4F46E5"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="TOTAL OUTSTANDING"
                        android:textColor="#C7D2FE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />
                    <TextView
                        android:id="@+id/tvTotalOutstanding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0.00"
                        android:textColor="#FFFFFF"
                        android:textSize="36sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- ── MAIN CONTENT (Rounded Overlay) ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-30dp"
                android:background="@drawable/bg_dashboard_main_corners"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Language Toggles -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_glass_pill"
                    android:padding="4dp">
                    <TextView
                        android:id="@+id/btnLangEn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="English"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/bg_white_pill_shadow"/>
                    <TextView
                        android:id="@+id/btnLangTe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="తెలుగు"
                        android:textColor="@color/dashboard_text_secondary"
                        android:textSize="12sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp"/>
                </LinearLayout>

                <!-- 2x2 Quick Actions -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_payment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/dashboard_card">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_payment_premium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Payment" android:layout_marginTop="8dp" android:textSize="13sp" android:textColor="@color/dashboard_text_primary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_search"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/dashboard_card">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_search_premium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Search" android:layout_marginTop="8dp" android:textSize="13sp" android:textColor="@color/dashboard_text_primary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_new_customer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/dashboard_card">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_new_user_premium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New Connection" android:layout_marginTop="8dp" android:textSize="13sp" android:textColor="@color/dashboard_text_primary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_reports"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/dashboard_card">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_report_premium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reports" android:layout_marginTop="8dp" android:textSize="13sp" android:textColor="@color/dashboard_text_primary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </GridLayout>

                <!-- Collection Stats Grid -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Operational Metrics"
                    android:textColor="@color/dashboard_text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardTodayCollection"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/dashboard_card">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textSize="10sp" android:textColor="@color/dashboard_text_secondary"/>
                            <TextView android:id="@+id/tvTodayAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0" android:textStyle="bold" android:textColor="#3B82F6"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layoutPaid"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/dashboard_card">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Paid" android:textSize="10sp" android:textColor="@color/dashboard_text_secondary"/>
                            <TextView android:id="@+id/tvPaidCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textStyle="bold" android:textColor="#22C55E"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layoutUnpaid"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/dashboard_card">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unpaid" android:textSize="10sp" android:textColor="@color/dashboard_text_secondary"/>
                            <TextView android:id="@+id/tvUnpaidCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textStyle="bold" android:textColor="#EF4444"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardTotalCustomers"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/dashboard_card">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total" android:textSize="10sp" android:textColor="@color/dashboard_text_secondary"/>
                            <TextView android:id="@+id/tvTotalCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textStyle="bold" android:textColor="#A855F7"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardActiveCustomers"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/dashboard_card">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active" android:textSize="10sp" android:textColor="@color/dashboard_text_secondary"/>
                            <TextView android:id="@+id/tvActiveCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textStyle="bold" android:textColor="#22C55E"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardOpenComplaints"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/dashboard_card">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tickets" android:textSize="10sp" android:textColor="@color/dashboard_text_secondary"/>
                            <TextView android:id="@+id/tvOpenComplaints" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textStyle="bold" android:textColor="#F59E0B"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Hidden Components for compatibility -->
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone">
                    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="0dp" android:layout_height="0dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnLanguageToggle" android:layout_width="0dp" android:layout_height="0dp" />
                    <ImageView android:id="@+id/btnBluetooth" android:layout_width="0dp" android:layout_height="0dp" />
                    <ImageView android:id="@+id/btnLogout" android:layout_width="0dp" android:layout_height="0dp" />
                    <TextView android:id="@+id/tvPartialCount" android:layout_width="0dp" android:layout_height="0dp" />
                    <TextView android:id="@+id/tvInactiveCount" android:layout_width="0dp" android:layout_height="0dp" />
                    <TextView android:id="@+id/tvTodayPayments" android:layout_width="0dp" android:layout_height="0dp" />
                    <TextView android:id="@+id/tvTotalBilling" android:layout_width="0dp" android:layout_height="0dp" />
                    <TextView android:id="@+id/tvTotalCollection" android:layout_width="0dp" android:layout_height="0dp" />
                    <TextView android:id="@+id/tvOneTimeCharges" android:layout_width="0dp" android:layout_height="0dp" />
                    <TextView android:id="@+id/tvCompletedComplaints" android:layout_width="0dp" android:layout_height="0dp" />
                    <TextView android:id="@+id/tvMonthAmount" android:layout_width="0dp" android:layout_height="0dp" />
                    <View android:id="@+id/sectionRevenue" android:layout_width="0dp" android:layout_height="0dp" />
                    <View android:id="@+id/cardTodayPayments" android:layout_width="0dp" android:layout_height="0dp" />
                    <View android:id="@+id/cardOneTimeCharges" android:layout_width="0dp" android:layout_height="0dp" />
                    <View android:id="@+id/cardCompletedComplaints" android:layout_width="0dp" android:layout_height="0dp" />
                    <View android:id="@+id/layoutPartial" android:layout_width="0dp" android:layout_height="0dp" />
                    <View android:id="@+id/cardInactiveCustomers" android:layout_width="0dp" android:layout_height="0dp" />
                    <View android:id="@+id/btn_new_connection" android:layout_width="0dp" android:layout_height="0dp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/dashboard_bottom_nav"
        app:itemIconTint="@color/dashboard_text_secondary"
        app:itemTextColor="@color/dashboard_text_secondary"
        app:menu="@menu/bottom_nav_menu"
        app:elevation="8dp" />

    <FrameLayout
        android:id="@+id/fabAdd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_fab_gradient"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_input_add"
            app:tint="#FFFFFF"
            android:layout_gravity="center" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
