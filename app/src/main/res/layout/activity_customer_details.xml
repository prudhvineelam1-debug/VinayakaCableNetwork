<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customer Details"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#1976D2"
            android:padding="16dp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp">

            <!-- NAME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textColor="#888"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <!-- SERIES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Series Number"
                android:textColor="#888"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvSeries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <!-- PHONE -->
            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Phone Number"
                android:background="@drawable/search_bg"
                android:padding="12dp"
                android:layout_marginBottom="16dp"/>

            <!-- AMOUNT BOX -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#EAF2FF"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvBaseAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Base Amount: ₹0"
                    android:textStyle="bold"
                    android:textColor="#1565C0"/>

                <TextView
                    android:id="@+id/tvPendingAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Previous Due: ₹0"
                    android:textStyle="bold"
                    android:textColor="#C62828"/>
            </LinearLayout>

            <!-- EXTRA -->
            <EditText
                android:id="@+id/etManualAmount"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="DC / Extra Charges"
                android:background="@drawable/search_bg"
                android:padding="12dp"
                android:layout_marginBottom="16dp"/>

            <!-- FINAL BILL -->
            <TextView
                android:id="@+id/tvFinalBill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Final Bill ₹0"
                android:textStyle="bold"
                android:textSize="18sp"
                android:gravity="center"
                android:background="#2E7D32"
                android:textColor="#FFFFFF"
                android:padding="14dp"
                android:layout_marginBottom="16dp"/>

            <!-- PAID -->
            <EditText
                android:id="@+id/etAmountPaid"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Amount Paid"
                android:background="@drawable/search_bg"
                android:padding="12dp"
                android:layout_marginBottom="16dp"/>

            <!-- PAYMENT MODE -->
            <Spinner
                android:id="@+id/spPaymentMode"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"/>

            <!-- PAYMENT NUMBER -->
            <EditText
                android:id="@+id/etPaymentNumber"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="PhonePe / UPI Number"
                android:background="@drawable/search_bg"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <!-- BUTTON -->
            <Button
                android:id="@+id/btnSubmitPayment"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Submit Payment"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#1976D2"
                android:textAllCaps="false"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>