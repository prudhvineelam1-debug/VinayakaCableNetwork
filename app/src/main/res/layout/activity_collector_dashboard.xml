<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vinayaka Cable Network"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#638FED"
            android:padding="20dp"
            android:gravity="center" />

        <!-- SEARCH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search Customer"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:background="@drawable/search_bg"
                android:paddingStart="12dp"
                android:paddingEnd="6dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="#888"/>

                <EditText
                    android:id="@+id/etSearchSeries"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:hint="Enter ID / Phone"
                    android:background="@android:color/transparent"
                    android:paddingStart="8dp"/>

                <Button
                    android:id="@+id/btnSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Search"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:background="@drawable/search_button_bg"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- CUSTOMER DETAILS -->
        <LinearLayout
            android:id="@+id/formLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_margin="16dp"
            android:padding="16dp">

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Details"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#1976D2"
                android:layout_marginBottom="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"/>

            <!-- NAME -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:tint="#1976D2"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Name"
                    android:layout_marginStart="8dp"/>

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"/>

            <!-- SERIES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    android:tint="#1976D2"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Series Number"
                    android:layout_marginStart="8dp"/>

                <TextView
                    android:id="@+id/tvSeries"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"/>

            <!-- PHONE -->
            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Phone Number"
                android:background="@drawable/search_bg"
                android:padding="12dp"
                android:layout_marginTop="10dp"/>

            <!-- AMOUNT BOX -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F5F9FF"
                android:padding="12dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvBaseAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Base Amount: ₹0"
                    android:textColor="#1976D2"/>

                <TextView
                    android:id="@+id/tvPendingAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Previous Due: ₹0"
                    android:textColor="#D32F2F"/>
            </LinearLayout>

            <!-- EXTRA -->
            <EditText
                android:id="@+id/etManualAmount"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="DC / Extra Charges"
                android:background="@drawable/search_bg"
                android:layout_marginTop="12dp"/>

            <!-- FINAL BILL -->
            <TextView
                android:id="@+id/tvFinalBill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Final Bill ₹0"
                android:textStyle="bold"
                android:textSize="18sp"
                android:gravity="center"
                android:background="#2E7D32"
                android:textColor="#FFFFFF"
                android:padding="16dp"
                android:layout_marginTop="12dp"/>

            <!-- PAID -->
            <EditText
                android:id="@+id/etAmountPaid"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Amount Paid"
                android:background="@drawable/search_bg"
                android:layout_marginTop="12dp"/>

            <!-- PAYMENT MODE -->
            <Spinner
                android:id="@+id/spPaymentMode"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"/>

            <!-- PAYMENT NUMBER -->
            <EditText
                android:id="@+id/etPaymentNumber"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="PhonePe / UPI Number"
                android:background="@drawable/search_bg"
                android:visibility="gone"
                android:layout_marginTop="12dp"/>

            <!-- BUTTON -->
            <Button
                android:id="@+id/btnSubmitPayment"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Submit Payment"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1976D2"
                android:textAllCaps="false"
                android:layout_marginTop="16dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>